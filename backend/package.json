{
  "name": "@snapland/backend",
  "version": "1.0.0",
  "private": true,
  "description": "Snapland API and WebSocket gateway (Fastify 5)",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --conditions=@snapland/source src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --enable-source-maps dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "test:coverage:all": "vitest run -c vitest.all.config.ts --coverage",
    "migrate": "tsx --conditions=@snapland/source src/scripts/migrate.ts",
    "seed": "tsx --conditions=@snapland/source src/scripts/seed.ts",
    "user-admin": "tsx --conditions=@snapland/source src/scripts/user-admin.ts",
    "openapi:export": "tsx --conditions=@snapland/source src/scripts/export-openapi.ts",
    "clean": "node -e \"for (const d of ['dist','coverage']) require('node:fs').rmSync(d,{recursive:true,force:true})\""
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.1.1",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/swagger": "9.9.0",
    "@fastify/swagger-ui": "6.1.1",
    "@fastify/websocket": "11.3.1",
    "@node-rs/argon2": "2.2.1",
    "@snapland/shared": "1.0.0",
    "close-with-grace": "2.5.0",
    "fastify": "5.12.5",
    "fastify-plugin": "6.0.0",
    "fastify-type-provider-zod": "7.0.0",
    "ioredis": "5.11.1",
    "jose": "6.2.12",
    "lru-cache": "11.5.3",
    "node-pg-migrate": "9.0.0",
    "openapi-types": "12.1.3",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "prom-client": "15.1.3",
    "ws": "8.22.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "@types/pg": "8.23.1",
    "@types/ws": "8.18.1",
    "@vitest/coverage-v8": "5.0.2",
    "pino-pretty": "13.1.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.2"
  }
}
