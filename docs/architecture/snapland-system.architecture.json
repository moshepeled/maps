  "cards": [
    {
      "dot": "violet",
      "title": "Real-time path",
      "items": [
        "The browser trades its JWT for a one-time ticket, then opens /ws (snapland.v1)",
        "A save on one replica is published to Redis; both replicas fan it out to their sockets",
        "Each socket gets only changes inside its viewport plus a 50% margin"
      ]
    },
    {
      "dot": "cyan",
      "title": "Inside each backend",
      "items": [
        "Modules: health, meta, auth, areas, realtime, admin, retention",
        "Drawing limit: 50 actions per minute per user, shared by REST and WebSocket in Redis",
        "Audit writer batches rows into audit_logs; retention purges old rows under an advisory lock"
      ]
    },
    {
      "dot": "emerald",
      "title": "Startup and operations",
      "items": [
        "A one-shot migrate container runs the SQL migrations before both backends start",
        "Every replica serves /health/live, /health/ready and /metrics",
        "nginx serves the app; every published port binds to 127.0.0.1"
      ]
    }
  ]
