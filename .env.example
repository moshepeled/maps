# Snapland environment (SPEC section 11.3). Copy with `node scripts/setup-env.mjs` (generates JWT_SECRET, never overwrites .env).
# Validated at boot by backend/src/config/env.ts; an invalid value stops the process with a list of every problem.

# -- Runtime -------------------------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info
# Ignored (forced to false) when NODE_ENV=production: pino-pretty is dev-only. Compose backends set it to false explicitly.
LOG_PRETTY=true
# Defaults to the host name; compose sets backend-1 / backend-2.
# INSTANCE_ID=backend-1
HOST=0.0.0.0
# Host port 3000 is taken on the dev machine: the backend listens on 3100 everywhere.
PORT=3100
# false | hop count (integer >= 1) | proxy-addr list. Compose (behind nginx) uses 1.
TRUST_PROXY=loopback
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
BODY_LIMIT_BYTES=262144
REQUEST_TIMEOUT_MS=10000
HTTP_REQUEST_TIMEOUT_MS=15000
SHUTDOWN_GRACE_MS=10000
DOCS_ENABLED=true
METRICS_ENABLED=true

# -- PostgreSQL ----------------------------------------------------------------------------------
DATABASE_URL=postgres://snapland:snapland@127.0.0.1:55432/snapland
DB_POOL_MAX=20
DB_STATEMENT_TIMEOUT_MS=5000
DB_CONNECTION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000

# -- Redis (critical state, noeviction) and redis-cache (L2 bbox bodies, allkeys-lru) -----------
REDIS_URL=redis://127.0.0.1:56379/0
# Empty disables the L2 cache (L1 only).
CACHE_REDIS_URL=redis://127.0.0.1:56380/0
CACHE_L2_MAX_BODY_BYTES=524288
CACHE_L1_MAX_ENTRY_BYTES=5242880
REDIS_KEY_PREFIX=snap:
REDIS_COMMAND_TIMEOUT_MS=1000

# -- Auth ----------------------------------------------------------------------------------------
# Placeholder: setup-env replaces it with a random secret; production refuses to boot with this value.
JWT_SECRET=replace-me-run-node-scripts-setup-env-mjs
JWT_ISSUER=snapland
JWT_AUDIENCE=snapland-api
ACCESS_TOKEN_TTL_S=900
REFRESH_TOKEN_TTL_S=1209600
SESSION_ABSOLUTE_TTL_S=2592000
COOKIE_SECURE=true

# -- WebSocket -----------------------------------------------------------------------------------
WS_TICKET_TTL_S=30
WS_MAX_PAYLOAD_BYTES=65536
WS_PING_INTERVAL_MS=20000
WS_MAX_CONNECTIONS_PER_INSTANCE=5000
WS_MAX_CONNECTIONS_PER_USER=10
WS_SEND_HIGH_WATER_BYTES=262144
WS_SLOW_CONSUMER_TIMEOUT_MS=10000
WS_OUTBOUND_MAX_MESSAGES=500
WS_OUTBOUND_MAX_BYTES=1048576
WS_UPGRADE_RATE_LIMIT_MAX=60
WS_MAX_LOCKS_PER_CONNECTION=3
WS_PERMESSAGE_DEFLATE=false

# -- Realtime timings ----------------------------------------------------------------------------
REALTIME_PRESENCE_REFRESH_MS=15000
REALTIME_PRESENCE_SWEEP_MS=15000
REALTIME_PRESENCE_STALE_MS=45000
REALTIME_DRAFT_IDLE_MS=120000
REALTIME_DRAFT_KEYFRAME_MS=5000
REALTIME_DRAFT_COALESCE_MS=50
REALTIME_DRAFT_TOUCH_INTERVAL_MS=20000
REALTIME_SESSION_REVALIDATE_MS=60000
REALTIME_DRAFT_RESUME_WINDOW_S=120
REALTIME_LOCK_TTL_MS=30000

# -- Rate limits (per minute) --------------------------------------------------------------------
DRAW_RATE_LIMIT_MAX=50
DRAW_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10
REFRESH_RATE_LIMIT_MAX=60

# -- Bbox cache ----------------------------------------------------------------------------------
CACHE_ENABLED=true
CACHE_BBOX_TTL_S=120
CACHE_L1_MAX_ENTRIES=500
CACHE_L1_TTL_MS=30000

# -- Retention -----------------------------------------------------------------------------------
RETENTION_ENABLED=true
RETENTION_INTERVAL_MS=3600000
RETENTION_BATCH_SIZE=1000
RETENTION_INITIAL_DELAY_MS=60000
RETENTION_STATEMENT_TIMEOUT_MS=60000
AREA_PURGE_AFTER_DAYS=30
AUDIT_RETENTION_DAYS=90
SESSION_PURGE_AFTER_DAYS=7

# -- Audit ---------------------------------------------------------------------------------------
AUDIT_QUEUE_MAX=10000
AUDIT_BATCH_SIZE=500
AUDIT_FLUSH_INTERVAL_MS=1000

# -- Compose only (never 3000 / 5433 / 8060 / 8787) ----------------------------------------------
POSTGRES_USER=snapland
POSTGRES_PASSWORD=snapland
POSTGRES_DB=snapland
PG_HOST_PORT=55432
REDIS_HOST_PORT=56379
REDIS_CACHE_HOST_PORT=56380
HTTP_HOST_PORT=5173

# -- Tests and tools -----------------------------------------------------------------------------
TEST_DATABASE_ADMIN_URL=postgres://snapland:snapland@127.0.0.1:55432/postgres
TEST_REDIS_URL=redis://127.0.0.1:56379/1
TEST_CACHE_REDIS_URL=redis://127.0.0.1:56380/1
E2E_BASE_URL=http://localhost:5173
SEED_USER_PASSWORD=loadtest-password-123

# -- Frontend (build time) -----------------------------------------------------------------------
VITE_API_BASE=/api/v1
# Build args of the nginx image (Vite reads frontend/.env*, not this file). The GovMap 2022 ITM layer is the default
# Aerial source in every build (user decision D-1, section 8.3); `false` is a kill switch that shows Esri World Imagery instead.
VITE_ENABLE_ITM_LAYER=true
VITE_E2E_HOOKS=false
